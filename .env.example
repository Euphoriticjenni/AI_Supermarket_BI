# ============================================================
# AI_Supermarket_BI - Environment configuration template
# Copy this file to .env and adjust the values.
#   cp .env.example .env
# All variables are OPTIONAL. The project works fully offline
# without an OpenAI key (the AI assistant falls back to a
# rule-based query engine).
# ============================================================

# Optional: OpenAI API key for the LLM-powered assistant.
# If missing or invalid, the assistant uses the offline template engine.
OPENAI_API_KEY=your_key_here

# Optional: model to use when the OpenAI key is configured.
OPENAI_MODEL=gpt-3.5-turbo

# SQLite database location (relative paths resolve against the project root).
DATABASE_PATH=database/supermarket.db

# Console log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Directory where PDF reports are written.
REPORT_PATH=reports/
